{
  "name": "crystal-erp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "build": "docker compose build",
    "db:migrate": "npm run migrate --workspace=backend",
    "db:generate": "npm run generate --workspace=backend",
    "db:backup": "docker compose exec -T db mysqldump -u crystal -p${DB_PASSWORD} crystal_erp"
  }
}
